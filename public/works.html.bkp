<!DOCTYPE html>
<html lang="pt">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>IsabelFit | Planos</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@600;700;800&family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="/css/styles.css" />
    <script src="/js/isabelfit.js" defer></script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a href="/index.html" class="brand" aria-label="IsabelFit home">
          <span class="brand-mark"><i class="fa-solid fa-dumbbell"></i></span>
          <span>IsabelFit</span>
        </a>

        <nav class="main-nav" aria-label="Menu principal">
          <a href="/index.html#inicio">Início</a>
          <a href="/index.html#alimentar">Plano alimentar</a>
          <a href="/index.html#avaliacao">Avaliação</a>
          <a href="/index.html#planos">Planos</a>
          <a href="/index.html#contactos">Contactos</a>
          <a href="/index.html#contactos" class="nav-button">Agendar</a>
        </nav>

        <button class="mobile-toggle" type="button" aria-label="Abrir menu" data-toggle-menu>
          <i class="fa-solid fa-bars"></i>
        </button>
      </div>

      <div class="mobile-menu" id="mobile-menu">
        <a href="/index.html#inicio">Início</a>
        <a href="/index.html#alimentar">Plano alimentar</a>
        <a href="/index.html#avaliacao">Avaliação</a>
        <a href="/index.html#planos">Planos</a>
        <a href="/index.html#contactos">Contactos</a>
      </div>
    </header>

    <main style="padding: 5rem 0; background: #f4efe9;">
      <div class="container">
        <div class="contact-card" style="max-width: 980px; margin: 0 auto;">
          <h3 style="font-size: clamp(2.3rem, 5vw, 4rem);">Planos IsabelFit</h3>
          <p style="font-size: 1.08rem; line-height: 1.7; margin: 0 0 1.4rem;">Cada plano é pensado para a tua rotina, objetivos e nível atual. A combinação entre treino, alimentação e acompanhamento é o que transforma resultados em hábitos.</p>

          <div class="plans-grid" style="grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); width: 100%;">
            <article class="plan-card featured" style="background: rgba(216, 178, 106, 0.05);">
              <div class="tag">Pack 1</div>
              <h3>4 Sessões</h3>
              <div class="sessions">Treino personalizado</div>
              <ul>
                <li>Orientação inicial</li>
                <li>Plano adaptado</li>
                <li>Acompanhamento semanal</li>
              </ul>
              <div class="price">135€</div>
            </article>

            <article class="plan-card featured">
              <div class="tag">Pack 2</div>
              <h3>8 Sessões</h3>
              <div class="sessions">Treino personalizado</div>
              <ul>
                <li>30 minutos</li>
                <li>Foco em resultados</li>
                <li>Progressão clara</li>
              </ul>
              <div class="price">283,36€</div>
            </article>

            <article class="plan-card featured">
              <div class="tag">Pack 3</div>
              <h3>12 Sessões</h3>
              <div class="sessions">Treino personalizado</div>
              <ul>
                <li>30 minutos</li>
                <li>Foco em resultados</li>
                <li>Motivação constante</li>
              </ul>
              <div class="price">406,56€</div>
            </article>
          </div>
        </div>
      </div>
    </main>

    <footer class="site-footer">&copy; 2026 IsabelFit. Todos os direitos reservados.</footer>
  </body>
</html>

</html>
